<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.dshmobile.pethost"
    android:versionCode="46"
    android:versionName="6.11">

    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="28" />

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- v6.6 开机自启动：只用来在重启后把她拉回来（还要 ColorOS 那层自启动权限放行） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="DSH 桌宠悬浮窗"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:allowBackup="false"
        android:hardwareAccelerated="true">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 对话：隐形输入代理（v5）。窗口只有 2dp 高、全透明，唯一作用是托住系统输入法；
             真正的界面是页面里的原版 dsh-pet 弹窗（PetShared.mountChatDialog）。
             不要改回"可见输入条"——那和原插件的界面不一致。 -->
        <activity
            android:name=".ChatInputActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustNothing|stateVisible"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service android:name=".PetService" android:exported="false" />

        <!-- v6.6 开机自启动（控制面板里「开机自动启动」那个开关管的就是它）。
             注意：ColorOS 的「自启动权限」不给的话，这个广播根本送不到，别指望它绕过系统。 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- v5.0 模式 A：无障碍悬浮层。只借窗口权限（TYPE_ACCESSIBILITY_OVERLAY
             不会被 ROM 压暗），不监听任何事件、不读屏幕内容。 -->
        <service
            android:name=".PetA11y"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/pet_a11y" />
        </service>
    </application>
</manifest>
